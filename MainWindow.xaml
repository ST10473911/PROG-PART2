<<Window x:Class="CybersecurityChatbotGUI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Cybersecurity Awareness Bot - South Africa" 
        Height="700" Width="900"
        WindowStartupLocation="CenterScreen"
        Background="#1E1E1E">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ASCII Art Header -->
        <Border Grid.Row="0" Background="#0D2B3E" Padding="5">
            <TextBlock x:Name="AsciiArtTextBlock" 
                       FontFamily="Consolas" 
                       FontSize="8" 
                       Foreground="#00FF00" 
                       TextAlignment="Center"
                       FontWeight="Bold"/>
        </Border>

        <!-- Chat History -->
        <Border Grid.Row="1" Background="#2D2D2D" CornerRadius="10" Margin="10" Padding="10">
            <ScrollViewer>
                <ListBox x:Name="ChatHistoryListBox" 
                         Background="#2D2D2D" 
                         Foreground="White" 
                         FontFamily="Segoe UI" 
                         FontSize="13"
                         BorderThickness="0">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}" TextWrapping="Wrap" Margin="0,3"/>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </ScrollViewer>
        </Border>

        <!-- User Input -->
        <Grid Grid.Row="2" Margin="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBox x:Name="UserInputTextBox" 
                     Grid.Column="0"
                     Background="#3D3D3D" 
                     Foreground="White" 
                     FontSize="14"
                     Padding="12"
                     BorderThickness="0"
                     KeyDown="UserInputTextBox_KeyDown"/>

            <Button x:Name="SendButton" 
                    Grid.Column="1"
                    Content="Send" 
                    Width="80"
                    Margin="10,0,0,0"
                    Background="#007ACC" 
                    Foreground="White"
                    FontSize="13"
                    FontWeight="Bold"
                    Click="SendButton_Click"/>
        </Grid>

        <!-- Quiz Status Bar -->
        <Border Grid.Row="3" Background="#0D2B3E" Padding="5">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" x:Name="QuizStatusTextBlock" Foreground="#FFD700" FontSize="11" HorizontalAlignment="Left"/>
                <TextBlock Grid.Column="1" x:Name="ScoreTextBlock" Foreground="#00FF00" FontSize="11" HorizontalAlignment="Center"/>
                <TextBlock Grid.Column="2" x:Name="StatusTextBlock" Foreground="#00FF00" FontSize="11" HorizontalAlignment="Right"/>
            </Grid>
        </Border>
    </Grid>
    </Window>
