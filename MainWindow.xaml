<Window x:Class="CybersecurityChatbotGUI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Cybersecurity Awareness Chatbot" 
        Height="600" Width="800"
        WindowStartupLocation="CenterScreen"
        Background="#1E1E1E">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ASCII Art Header -->
        <Border Grid.Row="0" Background="#2D2D2D" Padding="10" Margin="5">
            <TextBlock x:Name="AsciiArtTextBlock" 
                       Text="Loading ASCII Art..." 
                       FontFamily="Consolas" 
                       FontSize="10" 
                       Foreground="#00FF00" 
                       TextAlignment="Center"
                       FontWeight="Bold"/>
        </Border>

        <!-- Chat History Display -->
        <Border Grid.Row="2" Background="#2D2D2D" CornerRadius="10" Margin="10" Padding="10">
            <ListBox x:Name="ChatHistoryListBox" 
                     Background="#2D2D2D" 
                     Foreground="White" 
                     FontFamily="Segoe UI" 
                     FontSize="14"
                     BorderThickness="0">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding}" TextWrapping="Wrap" Margin="0,5"/>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>

        <!-- User Input Area -->
        <Grid Grid.Row="3" Margin="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBox x:Name="UserInputTextBox" 
                     Grid.Column="0"
                     Background="#3D3D3D" 
                     Foreground="White" 
                     FontSize="14"
                     Padding="10"
                     BorderThickness="0"
                     KeyDown="UserInputTextBox_KeyDown"/>

            <Button x:Name="SendButton" 
                    Grid.Column="1"
                    Content="Send" 
                    Width="80"
                    Margin="10,0,0,0"
                    Background="#007ACC" 
                    Foreground="White"
                    FontSize="14"
                    FontWeight="Bold"
                    Click="SendButton_Click"/>
        </Grid>

        <!-- Status Bar -->
        <StatusBar Grid.Row="4" Background="#2D2D2D">
            <StatusBarItem>
                <TextBlock x:Name="StatusTextBlock" 
                           Foreground="#00FF00" 
                           Text="Ready to help you stay safe online!"/>
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>
